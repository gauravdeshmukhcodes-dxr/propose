<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gaurav ❤️ Prisha</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: linear-gradient(
        135deg,
        #ffd6e7,
        #fff5f9,
        #ffdce9
      );
      color: #555;
      overflow-x: hidden;
    }

    .screen {
      min-height: 100vh;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .screen.active {
      display: flex;
    }

    .card {
      width: 100%;
      max-width: 430px;
      padding: 35px 24px;
      background: rgba(255,255,255,.96);
      border-radius: 32px;
      text-align: center;
      box-shadow: 0 15px 50px rgba(190,70,120,.20);
    }

    .heart {
      font-size: 75px;
      animation: beat 1.1s infinite;
    }

    h1 {
      color: #e8437a;
      font-size: 36px;
      margin: 15px 0;
    }

    h2 {
      font-size: 21px;
      margin-bottom: 15px;
    }

    p {
      line-height: 1.7;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 50px;
      padding: 15px;
      margin-top: 18px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      transition: transform .2s;
    }

    button:active {
      transform: scale(.96);
    }

    .primary {
      background: #ff5c91;
      color: white;
    }

    .secondary {
      background: #eeeeee;
      color: #555;
    }

    .buttons {
      display: flex;
      gap: 12px;
    }

    .buttons button {
      width: 50%;
    }

    /* DATE / TIME / PLACE */

    .plan input {
      width: 100%;
      padding: 14px;
      margin: 7px 0 15px;
      border: 2px solid #ffd0df;
      border-radius: 15px;
      font-size: 16px;
      outline: none;
      background: #fffafd;
    }

    .plan input:focus {
      border-color: #ff7fa8;
    }

    .plan label {
      display: block;
      text-align: left;
      font-weight: bold;
    }

    /* RESULT */

    .result-card {
      margin-top: 20px;
      padding: 22px;
      background: #fff0f6;
      border-radius: 24px;
      display: none;
    }

    .result-card h2 {
      color: #e8437a;
    }

    .result-line {
      margin: 12px 0;
    }

    /* CELEBRATION */

    #celebration {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(255,182,210,.96);
    }

    .celebrate-card {
      width: 100%;
      max-width: 420px;
      padding: 40px 20px;
      background: white;
      border-radius: 35px;
      text-align: center;
      animation: pop .7s ease;
    }

    .big-heart {
      font-size: 90px;
      animation: beat .7s infinite;
    }

    .celebrate-card h1 {
      font-size: 48px;
    }

    /* CONFETTI */

    .confetti {
      position: fixed;
      top: -30px;
      z-index: 200;
      font-size: 25px;
      animation: fall 4s linear forwards;
      pointer-events: none;
    }

    @keyframes beat {
      50% {
        transform: scale(1.18);
      }
    }

    @keyframes pop {
      0% {
        transform: scale(.3);
        opacity: 0;
      }

      70% {
        transform: scale(1.08);
      }

      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    @keyframes fall {
      to {
        transform:
          translateY(110vh)
          rotate(720deg);
        opacity: 0;
      }
    }

    @media(max-width:380px) {
      h1 {
        font-size: 31px;
      }

      .heart {
        font-size: 65px;
      }

      .card {
        padding: 30px 19px;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       WELCOME
  ========================== -->

  <section id="welcome" class="screen active">

    <div class="card">

      <div class="heart">💌</div>

      <h1>Hi Prisha 🌸</h1>

      <p>
        Gaurav has something special
        to ask you...
        <br><br>
        Are you ready? 💕
      </p>

      <button
        class="primary"
        onclick="showScreen('proposal')">

        ENTER ✨

      </button>

    </div>

  </section>


  <!-- =========================
       PROPOSAL
  ========================== -->

  <section id="proposal" class="screen">

    <div class="card">

      <div class="heart">💗</div>

      <h1>Prisha</h1>

      <h2>
        Will you be someone special
        to me? 🌸
      </h2>

      <p>
        You make ordinary moments
        feel a little more special.
        <br><br>

        I really like having you
        in my life, and I wanted to
        ask you something from
        my heart. 💕
      </p>

      <div class="buttons">

        <button
          class="primary"
          onclick="yesClicked()">

          YES 💕

        </button>

        <button
          id="noButton"
          class="secondary"
          onclick="moveNo()">

          NO 🙈

        </button>

      </div>

    </div>

  </section>


  <!-- =========================
       PLAN
  ========================== -->

  <section id="plan" class="screen">

    <div class="card plan">

      <div class="heart">🌸</div>

      <h1>Your Choice 💕</h1>

      <p>
        Prisha, you choose our
        special moment.
      </p>

      <br>

      <label>
        📅 Date
      </label>

      <input
        type="date"
        id="date"
        required>


      <label>
        ⏰ Time
      </label>

      <input
        type="time"
        id="time"
        required>


      <label>
        📍 Place
      </label>

      <input
        type="text"
        id="place"
        placeholder="Your favorite place 🌷"
        required>


      <button
        class="primary"
        onclick="saveMoment()">

        💖 SAVE OUR MOMENT

      </button>


      <!-- SAVED MOMENT -->

      <div
        id="resultCard"
        class="result-card">

        <h2>
          🌸 Our Special Moment
        </h2>

        <div id="resultText"></div>

        <p>
          Gaurav ❤️ Prisha
        </p>


        <!-- EMAIL BUTTON -->

        <button
          class="primary"
          onclick="sendToGaurav()">

          💌 SEND TO GAURAV

        </button>

      </div>

    </div>

  </section>


  <!-- =========================
       CELEBRATION
  ========================== -->

  <div id="celebration">

    <div class="celebrate-card">

      <div class="big-heart">
        💖
      </div>

      <h1>
        YAYYY! 🎉
      </h1>

      <h2>
        Prisha said YES! 💕
      </h2>

      <p>
        Gaurav ❤️ Prisha
        <br><br>
        Now let's choose our
        special moment. 🌸
      </p>

      <button
        class="primary"
        onclick="closeCelebration()">

        Choose Our Moment ✨

      </button>

    </div>

  </div>


  <script>

    /* =========================
       SCREEN SWITCH
    ========================== */

    function showScreen(id) {

      document
        .querySelectorAll(".screen")
        .forEach(screen => {

          screen.classList.remove("active");

        });

      document
        .getElementById(id)
        .classList.add("active");
    }


    /* =========================
       YES BUTTON
    ========================== */

    function yesClicked() {

      document
        .getElementById("celebration")
        .style.display = "flex";

      for (let i = 0; i < 100; i++) {
        createConfetti();
      }
    }


    /* =========================
       CLOSE CELEBRATION
    ========================== */

    function closeCelebration() {

      document
        .getElementById("celebration")
        .style.display = "none";

      showScreen("plan");
    }


    /* =========================
       CONFETTI
    ========================== */

    function createConfetti() {

      const c =
        document.createElement("div");

      c.className = "confetti";

      const items = [
        "💖",
        "💕",
        "💗",
        "✨",
        "🌸",
        "🎉"
      ];

      c.textContent =
        items[
          Math.floor(
            Math.random() * items.length
          )
        ];

      c.style.left =
        Math.random() * 100 + "vw";

      c.style.animationDuration =
        (2 + Math.random() * 3) + "s";

      document.body.appendChild(c);

      setTimeout(() => {
        c.remove();
      }, 5000);
    }


    /* =========================
       NO BUTTON
    ========================== */

    function moveNo() {

      const button =
        document.getElementById("noButton");

      const x =
        Math.random() * 140 - 70;

      const y =
        Math.random() * 80 - 40;

      button.style.transform =
        `translate(${x}px, ${y}px)`;
    }


    /* =========================
       SAVE MOMENT
    ========================== */

    function saveMoment() {

      const date =
        document.getElementById("date").value;

      const time =
        document.getElementById("time").value;

      const place =
        document
          .getElementById("place")
          .value
          .trim();


      if (!date || !time || !place) {

        alert(
          "Please choose the date, time and place 💕"
        );

        return;
      }


      const formattedDate =
        new Date(date + "T00:00:00")
          .toLocaleDateString(
            "en-IN",
            {
              weekday: "long",
              day: "numeric",
              month: "long",
              year: "numeric"
            }
          );


      document
        .getElementById("resultText")
        .innerHTML = `

          <div class="result-line">
            📅 <strong>Date:</strong>
            ${formattedDate}
          </div>

          <div class="result-line">
            ⏰ <strong>Time:</strong>
            ${time}
          </div>

          <div class="result-line">
            📍 <strong>Place:</strong>
            ${escapeHTML(place)}
          </div>

          <br>

          A memory to remember forever 💕

        `;


      document
        .getElementById("resultCard")
        .style.display = "block";


      /* Save locally */

      localStorage.setItem(
        "gauravPrishaMoment",
        JSON.stringify({
          date: formattedDate,
          time: time,
          place: place
        })
      );
    }


    /* =========================
       SEND TO GAURAV
       FORMSubmit EMAIL LINK
    ========================== */

    function sendToGaurav() {

      const date =
        document.getElementById("date").value;

      const time =
        document.getElementById("time").value;

      const place =
        document
          .getElementById("place")
          .value
          .trim();


      if (!date || !time || !place) {

        alert(
          "Please save the moment first 💕"
        );

        return;
      }


      const formattedDate =
        new Date(date + "T00:00:00")
          .toLocaleDateString(
            "en-IN",
            {
              weekday: "long",
              day: "numeric",
              month: "long",
              year: "numeric"
            }
          );


      const message =
`🌸 Our Special Moment 🌸

Gaurav ❤️ Prisha

📅 Date: ${formattedDate}
⏰ Time: ${time}
📍 Place: ${place}

A beautiful memory to remember forever 💕`;


      /*
       * Your FormSubmit email-link endpoint
       */

      const emailURL =
        "https://formsubmit.co/el/nuvuyu" +
        "?name=" +
        encodeURIComponent("Prisha") +
        "&subject=" +
        encodeURIComponent(
          "💕 Gaurav & Prisha — Special Moment"
        ) +
        "&message=" +
        encodeURIComponent(message);


      window.location.href = emailURL;
    }


    /* =========================
       SAFE TEXT
    ========================== */

    function escapeHTML(text) {

      const div =
        document.createElement("div");

      div.textContent = text;

      return div.innerHTML;
    }

  </script>

</body>
</html>